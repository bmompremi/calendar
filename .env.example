# Neon Database Configuration
# Copy this file to .env and fill in your Neon database connection details

DATABASE_URL=postgresql://username:password@ep-xxx-xxx.us-east-2.aws.neon.tech/banking_db?sslmode=require

# Alternative format:
# DATABASE_HOST=ep-xxx-xxx.us-east-2.aws.neon.tech
# DATABASE_NAME=banking_db
# DATABASE_USER=username
# DATABASE_PASSWORD=password
# DATABASE_PORT=5432
